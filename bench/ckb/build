#!/bin/sh
set -eu
cd "$(dirname "$0")"
target=riscv64imac-unknown-none-elf
export RUSTFLAGS="-C target-feature=-a,+zba,+zbb,+zbc,+zbs -C passes=lower-atomic"
cargo build --locked --release --target "$target" --target-dir target
if [ "$#" -eq 1 ]; then
    cp "target/$target/release/ckb-leanvm-verifier" "$1"
fi
